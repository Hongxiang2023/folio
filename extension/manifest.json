{
  "manifest_version": 3,
  "name": "Refhaven Connector",
  "version": "0.1.4",
  "description": "Save scholarly references and accessible PDFs to your local Refhaven library.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:47821/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Refhaven"
  }
}
